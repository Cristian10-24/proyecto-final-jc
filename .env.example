# Desarrollo local: replica set propio en el puerto 27018 (npm run db:local).
# En Vercel (solo Production): la cadena de Atlas del usuario con readWrite sobre proyecto_final_jc.
MONGODB_URI=mongodb://127.0.0.1:27018/?replicaSet=rs0
MONGODB_DB=proyecto_final_jc
# Conexiones por instancia de Vercel. Bajo a propósito: cada instancia abre su propio pool.
MONGODB_MAX_POOL=5
# 32+ caracteres: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
APP_URL=http://localhost:3000
STUDENT_PORTAL_ENABLED=true
# Intentos por documento cada 15 min (búsquedas, aciertos o fallos) y tope alto de fallos por IP.
RATE_LIMIT_DOC_MAX=15
RATE_LIMIT_IP_MAX=300
